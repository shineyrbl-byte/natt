# Copy to .env. Never commit the real .env.

PORT=3000
DB_PATH=data/natt.db

# Lightning: "simulated" (demo, no real sats) or "lnbits" (real sats)
LIGHTNING_BACKEND=simulated
# For lnbits: create a wallet at your LNbits instance and copy its keys.
LNBITS_URL=https://demo.lnbits.com
LNBITS_INVOICE_KEY=
LNBITS_ADMIN_KEY=

# Nostr: comma-separated relays to publish ledger receipts to (optional)
NOSTR_RELAYS=wss://relay.damus.io,wss://nos.lol
# Secret that all group keys are derived from. Auto-generated into
# data/nostr.secret if empty. Back it up: losing it means new group keys.
NATT_NOSTR_SECRET=

# AI helper (optional). Without a key, built-in answers are used.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Display-only exchange rate. With LIVE_RATE=1 the server reads BTC/EUR from
# mempool.space every 10 minutes (FCFA is pegged to the euro). XOF_PER_SAT is
# the fallback when that fails, and the only rate when LIVE_RATE=0.
LIVE_RATE=1
XOF_PER_SAT=0.55
RATE_LIMIT_PER_MINUTE=120
