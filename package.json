{
  "name": "natt",
  "version": "0.1.0",
  "description": "Lightning tontines (rotating savings groups) with a Nostr ledger and an AI helper",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "demo": "rm -rf data/demo && DB_PATH=data/demo/natt.db SEED_DEMO=1 node src/server.js",
    "test": "NODE_ENV=test node --test",
    "build:pages": "node scripts/build-pages.mjs",
    "preview:pages": "npm run build:pages && npx --yes serve@14.2.4 dist-pages -l 3060"
  },
  "keywords": [
    "bitcoin",
    "lightning",
    "nostr",
    "tontine",
    "africa",
    "senegal"
  ],
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@noble/curves": "^2.0.1",
    "@scure/base": "^2.0.0",
    "express": "^5.3.0",
    "light-bolt11-decoder": "^3.2.0",
    "nostr-tools": "^2.26.0",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@noble/hashes": "^2.4.0",
    "buffer": "^6.0.3",
    "esbuild": "^0.28.2",
    "sql.js": "^1.15.2"
  }
}
